# EmailJS — get these from https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Production site URL (no trailing slash) — used for canonical, Open Graph, and schema
VITE_SITE_URL=https://www.fmeducationservices.com

# Google Analytics 4 measurement ID (optional). Analytics loads only after cookie consent.
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
